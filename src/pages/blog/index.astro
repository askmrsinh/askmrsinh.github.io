---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import '../../styles/blog.scss';

import Breadcrumb from '../../components/common/Breadcrumb.astro';
import Article from '../../components/common/Article.astro';

const posts = await getCollection('blog');
---

<Layout isHeaderFixedAboveLg={true}>
  <main class="main blog index container">
    <header>
      <Breadcrumb />
      <hgroup>
        <h1 class="font-weight-800 letter-spacing-lg uppercase">Blog</h1>
        <p class="color font-weight-500 letter-spacing-md">
          Notes on the messy reality of solving problems with software.
        </p>
      </hgroup>
    </header>
    <section>
      {
        posts
          .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
          .map((post) => (
            <Article
              title={post.data.title}
              description={post.data.description}
              href={`/blog/${post.id}`}
              publishedAt={post.data.publishedAt}
              tags={post.data.tags}
            />
          ))
      }
    </section>
  </main>
</Layout>
